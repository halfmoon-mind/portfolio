---
import { getCollection } from 'astro:content';
import PortfolioDetail from '../../components/screens/PortfolioDetail.astro';
import { byLocale, baseSlug, hasSibling } from '../../i18n/content';
import { localizePath } from '../../i18n/ui';

export async function getStaticPaths() {
	const all = await getCollection('portfolio');
	return byLocale(all, 'ko').map((entry) => ({
		params: { slug: entry.id },
		props: {
			entry,
			langAlternate: hasSibling(all, entry, 'en')
				? localizePath(`/portfolio/${baseSlug(entry.id)}`, 'en')
				: null,
		},
	}));
}

const { entry, langAlternate } = Astro.props;
---

<PortfolioDetail entry={entry} locale="ko" langAlternate={langAlternate} />
