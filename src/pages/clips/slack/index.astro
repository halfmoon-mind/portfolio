---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../../consts';

const pageTitle = `${SITE_TITLE} Clips for Slack`;
const description =
  'Get new Half to Full Clips delivered to a Slack channel with a short personal comment and source link.';
---

<BaseLayout title={pageTitle} description={description} langAlternate={null}>
  <section class="slack-hero">
    <div class="hero-copy">
      <p class="eyebrow">Half to Full Clips for Slack</p>
      <h1>Curated reading notes in your Slack channel.</h1>
      <p class="lead">
        Half to Full Clips sends a message when a new Clip is published: a short
        comment, the original article source, tags, and a link back to the post.
      </p>
      <div class="actions">
        <a class="primary-action" href="/api/slack/install" aria-label="Add Half to Full Clips to Slack">
          <svg class="slack-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 122.8 122.8" aria-hidden="true">
            <path d="M25.8 77.6c0 7.1-5.8 12.9-12.9 12.9S0 84.7 0 77.6s5.8-12.9 12.9-12.9h12.9zm6.5 0c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9v32.3c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9z" fill="#e01e5a"/>
            <path d="M45.2 25.8c-7.1 0-12.9-5.8-12.9-12.9S38.1 0 45.2 0s12.9 5.8 12.9 12.9v12.9zm0 6.5c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H12.9C5.8 58.1 0 52.3 0 45.2s5.8-12.9 12.9-12.9z" fill="#36c5f0"/>
            <path d="M97 45.2c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9-5.8 12.9-12.9 12.9H97zm-6.5 0c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V12.9C64.7 5.8 70.5 0 77.6 0s12.9 5.8 12.9 12.9z" fill="#2eb67d"/>
            <path d="M77.6 97c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9-12.9-5.8-12.9-12.9V97zm0-6.5c-7.1 0-12.9-5.8-12.9-12.9s5.8-12.9 12.9-12.9h32.3c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9z" fill="#ecb22e"/>
          </svg>
          <span>Add to Slack</span>
        </a>
        <a class="secondary-action" href="/clips">Browse Clips</a>
      </div>
    </div>

    <aside class="message-preview" aria-label="Example Slack notification">
      <div class="preview-bar">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
      </div>
      <div class="preview-channel">#reading</div>
      <div class="preview-message">
        <div class="app-icon">H</div>
        <div>
          <div class="message-head">
            <strong>Half to Full Clips</strong>
            <span>now</span>
          </div>
          <h2>New clip on Half to Full</h2>
          <p>
            A concise note about an article worth revisiting, with the original
            source and tags attached for context.
          </p>
          <div class="source-row">Source: example.com</div>
          <button type="button">Open on halfmoon.day</button>
        </div>
      </div>
    </aside>
  </section>

  <section class="info-grid" aria-label="How the Slack app works">
    <article>
      <h2>What it does</h2>
      <p>
        The app posts new Half to Full Clips to the Slack channel selected
        during installation. Each message includes a title, short comment,
        source link, optional quote, tags, and a button to read the Clip.
      </p>
    </article>
    <article>
      <h2>What it accesses</h2>
      <p>
        The app only requests Slack's <code>incoming-webhook</code> permission.
        It stores the selected workspace and channel metadata plus the webhook
        URL needed to send notifications.
      </p>
    </article>
    <article>
      <h2>What it does not do</h2>
      <p>
        It does not read Slack messages, files, user profiles, email addresses,
        private channels, or conversation history. It does not use generative AI
        or train models on Slack data.
      </p>
    </article>
  </section>

  <section class="legal-links" aria-label="Legal and support links">
    <h2>Legal and support</h2>
    <ul>
      <li><a href="/clips/slack/privacy">Privacy Policy</a></li>
      <li><a href="/clips/slack/terms">Terms of Service</a></li>
      <li><a href="/clips/slack/support">Support</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .slack-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 2rem;
    align-items: center;
    padding: 2.5rem 0 2rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .lead {
    max-width: 42rem;
    color: rgb(var(--gray));
    font-size: 1.08rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid rgba(var(--gray-medium), 0.9);
    border-radius: 8px;
    font-weight: 700;
  }

  .primary-action {
    gap: 0.5rem;
    background: rgb(var(--black));
    color: #fff;
  }

  .primary-action:hover {
    color: #fff;
    background: rgb(var(--gray-dark));
  }

  .secondary-action {
    background: #fff;
    color: rgb(var(--black));
  }

  .slack-logo {
    width: 20px;
    height: 20px;
  }

  .message-preview {
    overflow: hidden;
    border: 1px solid rgba(var(--gray-medium), 0.9);
    border-radius: 8px;
    background: #fff;
    box-shadow: var(--box-shadow);
  }

  .preview-bar {
    display: flex;
    gap: 0.45rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(var(--gray-medium), 0.6);
  }

  .dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .red { background: #ff5f57; }
  .yellow { background: #ffbd2e; }
  .green { background: #28c840; }

  .preview-channel {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(var(--gray-medium), 0.6);
    color: rgb(var(--black));
    font-weight: 700;
  }

  .preview-message {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 0.85rem;
    padding: 1rem;
  }

  .app-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: #1f2937;
    color: #fff;
    font-weight: 800;
  }

  .message-head {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin-bottom: 0.25rem;
  }

  .message-head span,
  .source-row {
    color: rgb(var(--gray));
    font-size: 0.86rem;
  }

  .preview-message h2 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }

  .preview-message p {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .preview-message button {
    margin-top: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: 6px;
    background: #007a5a;
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }

  .info-grid article,
  .legal-links {
    border-top: 1px solid rgba(var(--gray-medium), 0.9);
    padding-top: 1rem;
  }

  .info-grid h2,
  .legal-links h2 {
    margin-top: 0;
    font-size: 1.15rem;
  }

  .info-grid p {
    margin: 0;
    color: rgb(var(--gray));
    font-size: 0.98rem;
  }

  .legal-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (max-width: 820px) {
    .slack-hero,
    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
