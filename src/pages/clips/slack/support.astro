---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../../consts';

const contactEmail = 'simsanghyeon00@gmail.com';
---

<BaseLayout
  title={`${SITE_TITLE} Clips for Slack - Support`}
  description="Support information for Half to Full Clips for Slack."
>
  <article class="support-page">
    <p class="eyebrow">Half to Full Clips for Slack</p>
    <h1>Support</h1>
    <p>
      For help with installation, notifications, privacy requests, or deletion
      requests, email <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
    </p>

    <section>
      <h2>Response time</h2>
      <p>
        Support requests are reviewed within 2 business days. Include your Slack
        workspace name, the selected channel, and a short description of the
        issue so the request can be handled quickly.
      </p>
    </section>

    <section>
      <h2>Installation</h2>
      <p>
        Install the app from the <a href="/clips/slack">Slack app landing page</a>.
        During installation, Slack will ask you to choose the channel where new
        Clip notifications should be posted.
      </p>
    </section>

    <section>
      <h2>Uninstalling</h2>
      <p>
        You can remove the app from your Slack workspace through Slack's app
        management settings. To request deletion of stored installation data,
        email <a href={`mailto:${contactEmail}`}>{contactEmail}</a> with your
        Slack workspace name or workspace ID.
      </p>
    </section>

    <section>
      <h2>Legal</h2>
      <ul>
        <li><a href="/clips/slack/privacy">Privacy Policy</a></li>
        <li><a href="/clips/slack/terms">Terms of Service</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .support-page {
    max-width: 760px;
    margin: 0 auto;
  }

  .eyebrow {
    margin-bottom: 0.25rem;
    color: var(--accent);
    font-size: 0.95rem;
    font-weight: 700;
  }

  li {
    margin-bottom: 0.4rem;
  }
</style>
