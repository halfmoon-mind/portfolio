---
import { getCollection, render } from 'astro:content';
import ClipPost from '../../layouts/ClipPost.astro';
import { byLocale, baseSlug, hasSibling } from '../../i18n/content';
import { localizePath, useTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  const all = await getCollection('clips');
  return byLocale(all, 'ko').map((clip) => ({
    params: { slug: clip.id },
    props: {
      clip,
      langAlternate: hasSibling(all, clip, 'en')
        ? localizePath(`/clips/${baseSlug(clip.id)}`, 'en')
        : null,
    },
  }));
}

const { clip, langAlternate } = Astro.props;
const { Content } = await render(clip);
const t = useTranslations('ko');
---

<ClipPost {...clip.data} langAlternate={langAlternate}>
  <Content />
  <div class="back-link-wrap">
    <a href={localizePath('/clips', 'ko')} class="back-link">{t('clips.back')}</a>
  </div>
</ClipPost>

<style>
  .back-link-wrap {
    text-align: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hm-color-border-default);
  }
  .back-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: var(--hm-font-weight-medium);
    padding: 0.5rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    transition: all 0.2s ease;
  }
  .back-link:hover {
    background: var(--accent);
    color: var(--hm-color-fg-inverted);
  }
</style>
