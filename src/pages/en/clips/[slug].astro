---
import { getCollection, render } from 'astro:content';
import ClipPost from '../../../layouts/ClipPost.astro';
import { byLocale, baseSlug, hasSibling } from '../../../i18n/content';
import { localizePath, useTranslations } from '../../../i18n/ui';

export async function getStaticPaths() {
  const all = await getCollection('clips');
  return byLocale(all, 'en').map((clip) => ({
    params: { slug: baseSlug(clip.id) },
    props: {
      clip,
      langAlternate: hasSibling(all, clip, 'ko')
        ? localizePath(`/clips/${baseSlug(clip.id)}`, 'ko')
        : null,
    },
  }));
}

const { clip, langAlternate } = Astro.props;
const { Content } = await render(clip);
const t = useTranslations('en');
---

<ClipPost {...clip.data} langAlternate={langAlternate}>
  <Content />
  <div class="back-link-wrap">
    <a href={localizePath('/clips', 'en')} class="back-link">{t('clips.back')}</a>
  </div>
</ClipPost>

<style>
  .back-link-wrap {
    text-align: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e5e5;
  }
  .back-link {
    color: rgb(var(--accent));
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(var(--accent));
    border-radius: 6px;
    transition: all 0.2s ease;
  }
  .back-link:hover {
    background: rgb(var(--accent));
    color: white;
  }
</style>
