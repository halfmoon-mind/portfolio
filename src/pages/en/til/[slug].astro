---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { byLocale, baseSlug, hasSibling } from '../../../i18n/content';
import { localizePath, useTranslations } from '../../../i18n/ui';

export async function getStaticPaths() {
	const all = await getCollection('til');
	return byLocale(all, 'en').map((post) => ({
		params: { slug: baseSlug(post.id) },
		props: {
			post,
			langAlternate: hasSibling(all, post, 'ko')
				? localizePath(`/til/${baseSlug(post.id)}`, 'ko')
				: null,
		},
	}));
}

const { post, langAlternate } = Astro.props;
const { Content } = await render(post);
const t = useTranslations('en');
---

<BlogPost {...post.data} langAlternate={langAlternate}>
	<Content />

	<div class="til-navigation mt-8">
		<a href={localizePath('/til', 'en')} class="back-link">{t('til.back')}</a>
	</div>
</BlogPost>

<style>
	.til-navigation {
		text-align: center;
		margin-top: 2rem;
		padding-top: 2rem;
		border-top: 1px solid #e5e5e5;
	}

	.back-link {
		color: rgb(var(--accent));
		text-decoration: none;
		font-weight: 500;
		padding: 0.5rem 1rem;
		border: 1px solid rgb(var(--accent));
		border-radius: 6px;
		transition: all 0.2s ease;
	}

	.back-link:hover {
		background: rgb(var(--accent));
		color: white;
	}
</style>
