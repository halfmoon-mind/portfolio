---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { byLocale, baseSlug, hasSibling } from '../../i18n/content';
import { localizePath, useTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
	const all = await getCollection('til');
	return byLocale(all, 'ko').map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			langAlternate: hasSibling(all, post, 'en')
				? localizePath(`/til/${baseSlug(post.id)}`, 'en')
				: null,
		},
	}));
}

const { post, langAlternate } = Astro.props;
const { Content } = await render(post);
const t = useTranslations('ko');
---

<BlogPost {...post.data} langAlternate={langAlternate}>
	<Content />

	<div class="til-navigation mt-8">
		<a href={localizePath('/til', 'ko')} class="back-link">{t('til.back')}</a>
	</div>
</BlogPost>

<style>
	.til-navigation {
		text-align: center;
		margin-top: 2rem;
		padding-top: 2rem;
		border-top: 1px solid var(--hm-color-border-default);
	}

	.back-link {
		color: var(--accent);
		text-decoration: none;
		font-weight: var(--hm-font-weight-medium);
		padding: 0.5rem 1rem;
		border: 1px solid var(--accent);
		border-radius: 6px;
		transition: all 0.2s ease;
	}

	.back-link:hover {
		background: var(--accent);
		color: var(--hm-color-fg-inverted);
	}
</style>
