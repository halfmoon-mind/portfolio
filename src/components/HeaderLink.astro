---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// Strip the /en locale prefix so active-state matching is locale-agnostic.
const strip = (p: string) => (p === '/en' || p === '/en/' ? '/' : p.startsWith('/en/') ? p.slice(3) : p);
const pathname = strip(Astro.url.pathname.replace(import.meta.env.BASE_URL, ''));
const hrefBase = strip(typeof href === 'string' ? href : '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = hrefBase === pathname || hrefBase === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
