---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import {
	education,
	experiences,
	openSourceProjects,
	resumeIntro,
	resumeProfile,
	skillCategories,
	talks,
} from '../../data/resume';
import '../../styles/resume.css';
import type { Locale } from '../../i18n/ui';

interface Props {
	locale?: Locale;
}
// Resume content stays Korean-only; only the surrounding chrome/nav follows the
// locale, so visiting /en/resume keeps the visitor in English mode.
const { locale = 'ko' } = Astro.props;

const title = `Resume | ${SITE_TITLE}`;
const description = '심상현의 이력서';

const getLinkTarget = (href: string) => (href.startsWith('http') ? '_blank' : undefined);
const getLinkRel = (href: string) => (href.startsWith('http') ? 'noopener noreferrer' : undefined);
const getIconClass = (label: string, href: string) => {
	if (href.startsWith('mailto:')) return 'fa-regular fa-envelope';
	if (href.includes('github.com')) return 'fa-brands fa-github';
	if (href.includes('apps.apple.com')) return 'fa-brands fa-apple';
	if (href.includes('play.google.com')) return 'fa-brands fa-android';
	if (href.includes('youtube.com')) return 'fa-brands fa-youtube';
	if (href.endsWith('.pdf') || label.includes('발표자료')) return 'fa-regular fa-file-pdf';
	return 'fa-solid fa-globe';
};
---

<BaseLayout title={title} description={description} locale={locale}>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

	<div class="resume-container">
		<div class="print-controls">
			<button id="savePdfBtn" class="pdf-button" type="button">PDF로 저장하기</button>
		</div>

		<header class="resume-header">
			<div class="profile-info">
				<img src={resumeProfile.image} alt={`${resumeProfile.name} 프로필 이미지`} class="profile-image" />
				<div class="profile-details">
					<h1 class="name">{resumeProfile.name}</h1>
					<p class="job-title">{resumeProfile.title}</p>
					<div class="contact-info">
						{
							resumeProfile.contacts.map((contact) => (
								<a
									href={contact.href}
									target={getLinkTarget(contact.href)}
									rel={getLinkRel(contact.href)}
									class="contact-item"
								>
									<i class={`${getIconClass(contact.label, contact.href)} icon`} aria-hidden="true"></i>
									{contact.label}
								</a>
							))
						}
					</div>
				</div>
			</div>

			<section class="intro-container" aria-labelledby="intro-title">
				<div class="section-title">
					<h2 id="intro-title">소개</h2>
					<div class="title-line"></div>
				</div>
				<div class="intro-content">
					{resumeIntro.map((paragraph) => <p class="intro-text" set:html={paragraph} />)}
				</div>
			</section>
		</header>

		<section class="resume-section" aria-labelledby="experience-title">
			<h2 id="experience-title">경력</h2>
			<div class="section-content career-timeline">
				{
					experiences.map((experience) => (
						<article class="experience-item">
							<div class="experience-header">
								<h3>{experience.role}</h3>
								<p class="period">{experience.period}</p>
							</div>
							<p class="position">{experience.company}</p>

							{experience.projects.map((project) => (
								<section class="project-subsection">
									<h4>{project.name}</h4>
									{project.links.length > 0 && (
										<div class="project-links">
											{project.links.map((link) => (
												<a
													href={link.href}
													target={getLinkTarget(link.href)}
													rel={getLinkRel(link.href)}
													class="link-button"
												>
													<i class={`${getIconClass(link.label, link.href)} icon`} aria-hidden="true"></i>
													{link.label}
												</a>
											))}
										</div>
									)}
									{project.responsibilities.length > 0 && (
										<ul class="responsibilities">
											{project.responsibilities.map((item) => <li set:html={item} />)}
										</ul>
									)}
								</section>
							))}
						</article>
					))
				}
			</div>
		</section>

		<section class="resume-section" aria-labelledby="skills-title">
			<h2 id="skills-title">기술 스택</h2>
			<div class="section-content skills">
				{
					skillCategories.map((category) => (
						<section class="skill-category">
							<h3>{category.name}</h3>
							<ul>
								{category.items.map((item) => <li>{item}</li>)}
							</ul>
						</section>
					))
				}
			</div>
		</section>

		<section class="resume-section" aria-labelledby="talks-title">
			<h2 id="talks-title">발표</h2>
			<div class="section-content talks-container">
				{
					talks.map((talk) => (
						<article class="talk-item">
							<div class="talk-year">{talk.year}</div>
							<div class="talk-content">
								<h3 class="talk-title">{talk.title}</h3>
								{talk.links.length > 0 && (
									<div class="talk-links">
										{talk.links.map((link) => (
											<a
												href={link.href}
												target={getLinkTarget(link.href)}
												rel={getLinkRel(link.href)}
												class="talk-link"
											>
												<i class={`${getIconClass(link.label, link.href)} icon`} aria-hidden="true"></i>
												{link.label}
											</a>
										))}
									</div>
								)}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="resume-section education-section" aria-labelledby="education-title">
			<div class="section-title">
				<h2 id="education-title">학력</h2>
				<div class="title-line"></div>
			</div>
			<div class="education-card">
				<div class="education-details">
					<h3>{education.school}</h3>
					<p>{education.department}</p>
					<p>{education.period}</p>
				</div>
			</div>
		</section>

		<section class="resume-section" aria-labelledby="opensource-title">
			<h2 id="opensource-title">오픈소스</h2>
			<div class="section-content opensource-projects">
				{
					openSourceProjects.map((project) => (
						<article class="project-card">
							<div class="project-header">
								<h3>{project.name}</h3>
								<span class="project-badge">{project.period}</span>
							</div>
							<a href={project.url} target="_blank" rel="noopener noreferrer" class="project-link">
								<i class={`${getIconClass(project.name, project.url)} icon`} aria-hidden="true"></i>
								{project.url.replace('https://', '')}
							</a>
							<ul class="project-features">
								{project.features.map((feature) => <li set:html={feature} />)}
							</ul>
						</article>
					))
				}
			</div>
		</section>
	</div>
</BaseLayout>

<script>
	// 네이티브 인쇄(PDF 저장) 사용 — html2canvas 캡처의 우측 잘림·래스터 흐림 없음, 텍스트 선택 가능한 벡터 PDF.
	// 인쇄용 레이아웃은 resume.css의 @media print 블록이 담당.
	const savePdfBtn = document.querySelector<HTMLButtonElement>('#savePdfBtn');
	const originalTitle = document.title;

	// 브라우저의 "PDF로 저장" 기본 파일명은 document.title을 따름
	window.addEventListener('beforeprint', () => {
		document.title = '심상현_이력서';
	});
	window.addEventListener('afterprint', () => {
		document.title = originalTitle;
	});

	savePdfBtn?.addEventListener('click', () => window.print());
</script>
