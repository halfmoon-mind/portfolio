---
import BaseHead from '../BaseHead.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import { byLocale, baseSlug } from '../../i18n/content';
import { type Locale, localizePath, siteDescription, hreflangFor } from '../../i18n/ui';

interface Props {
	locale?: Locale;
}
const { locale = 'ko' } = Astro.props;

const posts = byLocale(await getCollection('til'), locale).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const langAlternate = localizePath(Astro.url.pathname, locale === 'ko' ? 'en' : 'ko');
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={`${SITE_TITLE} - TIL`}
			description={siteDescription(locale)}
			locale={locale}
			alternates={hreflangFor(locale, Astro.url.pathname, langAlternate, Astro.site)}
		/>
		<style>
			* {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
			}

			main {
				max-width: 1012px;
				padding: 16px;
				margin: 0 auto;
			}

			.section-title {
				font-size: 2rem;
				font-weight: 600;
				color: #1f2328;
				margin-bottom: 16px;
				padding-bottom: 8px;
				border-bottom: 1px solid #d1d9e0;
			}

			.til-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.til-item {
				margin-bottom: 4px;
			}

			.til-link {
				display: flex;
				align-items: center;
				text-decoration: none;
				color: #0969da;
				font-size: 14px;
				line-height: 1.5;
				padding: 4px 0;
			}

			.til-link:hover {
				text-decoration: underline;
			}

			.til-link:visited {
				color: #8250df;
			}

			.bullet {
				margin-right: 8px;
				color: #656d76;
			}

			.til-title {
				flex: 1;
			}

			.til-date {
				margin-left: 16px;
				color: #656d76;
				font-size: 12px;
			}

			.tags {
				margin-left: 16px;
				display: flex;
				gap: 4px;
			}

			.tag {
				background-color: #f6f8fa;
				color: #656d76;
				border: 1px solid #d1d9e0;
				border-radius: 12px;
				padding: 2px 8px;
				font-size: 11px;
				font-weight: 500;
			}

			.tag.more-tags {
				background-color: #e3f2fd;
				color: #1976d2;
				border-color: #bbdefb;
			}

			@media (max-width: 768px) {
				main {
					padding: 16px 12px;
				}

				.til-link {
					flex-direction: column;
					align-items: flex-start;
				}

				.til-date,
				.tags {
					margin-left: 16px;
					margin-top: 4px;
				}
			}
		</style>
	</head>
	<body>
		<Header locale={locale} langAlternate={langAlternate} />
		<main>
			<h1 class="section-title">TIL (Today I Learned)</h1>
			<ul class="til-list">
				{
					posts.map((post) => (
						<li class="til-item">
							<a href={localizePath(`/til/${baseSlug(post.id)}`, locale)} class="til-link">
								<span class="bullet">•</span>
								<span class="til-title">{post.data.title}</span>
								<span class="til-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="tags">
										{post.data.tags.slice(0, 2).map((tag) => (
											<span class="tag">{tag}</span>
										))}
										{post.data.tags.length > 2 && (
											<span class="tag more-tags">+{post.data.tags.length - 3}</span>
										)}
									</div>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer locale={locale} />
	</body>
</html>
