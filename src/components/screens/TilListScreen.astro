---
import BaseHead from '../BaseHead.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import { byLocale, baseSlug } from '../../i18n/content';
import { type Locale, localizePath, siteDescription, hreflangFor } from '../../i18n/ui';

interface Props {
	locale?: Locale;
}
const { locale = 'ko' } = Astro.props;

const posts = byLocale(await getCollection('til'), locale).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const langAlternate = localizePath(Astro.url.pathname, locale === 'ko' ? 'en' : 'ko');
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={`${SITE_TITLE} - TIL`}
			description={siteDescription(locale)}
			locale={locale}
			alternates={hreflangFor(locale, Astro.url.pathname, langAlternate, Astro.site)}
		/>
		<style>
			* {
				font-family: var(--hm-font-family-sans);
			}

			main {
				max-width: 1012px;
				padding: 16px;
				margin: 0 auto;
			}

			.section-title {
				font-size: var(--hm-size-font-3xl);
				font-weight: var(--hm-font-weight-semibold);
				color: var(--hm-color-fg-default);
				margin-bottom: 16px;
				padding-bottom: 8px;
				border-bottom: 1px solid var(--hm-color-border-default);
			}

			.til-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.til-item {
				margin-bottom: 4px;
			}

			.til-link {
				display: flex;
				align-items: center;
				text-decoration: none;
				color: var(--hm-color-fg-link);
				font-size: var(--hm-size-font-sm);
				line-height: var(--hm-font-line-height-normal);
				padding: 4px 0;
			}

			.til-link:hover {
				text-decoration: underline;
			}

			.til-link:visited {
				color: #8250df;
			}

			.bullet {
				margin-right: 8px;
				color: var(--hm-color-fg-muted);
			}

			.til-title {
				flex: 1;
			}

			.til-date {
				margin-left: 16px;
				color: var(--hm-color-fg-muted);
				font-size: var(--hm-size-font-xs);
			}

			.tags {
				margin-left: 16px;
				display: flex;
				gap: 4px;
			}

			.tag {
				background-color: var(--hm-color-bg-subtle);
				color: var(--hm-color-fg-muted);
				border: 1px solid var(--hm-color-border-default);
				border-radius: 12px;
				padding: 2px 8px;
				font-size: var(--hm-size-font-xs);
				font-weight: var(--hm-font-weight-medium);
			}

			.tag.more-tags {
				background-color: var(--hm-color-blue-50);
				color: var(--hm-color-fg-link);
				border-color: var(--hm-color-blue-200);
			}

			@media (max-width: 768px) {
				main {
					padding: 16px 12px;
				}

				.til-link {
					flex-direction: column;
					align-items: flex-start;
				}

				.til-date,
				.tags {
					margin-left: 16px;
					margin-top: 4px;
				}
			}
		</style>
	</head>
	<body>
		<Header locale={locale} langAlternate={langAlternate} />
		<main>
			<h1 class="section-title">TIL (Today I Learned)</h1>
			<ul class="til-list">
				{
					posts.map((post) => (
						<li class="til-item">
							<a href={localizePath(`/til/${baseSlug(post.id)}`, locale)} class="til-link">
								<span class="bullet">•</span>
								<span class="til-title">{post.data.title}</span>
								<span class="til-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="tags">
										{post.data.tags.slice(0, 2).map((tag) => (
											<span class="tag">{tag}</span>
										))}
										{post.data.tags.length > 2 && (
											<span class="tag more-tags">+{post.data.tags.length - 3}</span>
										)}
									</div>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer locale={locale} />
	</body>
</html>
