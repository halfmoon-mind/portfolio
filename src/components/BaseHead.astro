---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { type Locale, ogLocale, useTranslations, siteDescription } from '../i18n/ui';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: string;
	article?: boolean;
	locale?: Locale;
	alternates?: { hreflang: string; href: string }[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	locale = 'ko',
	description = siteDescription(locale),
	image = '/og-image-v2.png',
	article = false,
	alternates = [],
} = Astro.props;

const t = useTranslations(locale);

// OG 이미지 권장 크기 (소셜 미디어 플랫폼 메타용)
const OG_IMAGE_WIDTH = 1200;
const OG_IMAGE_HEIGHT = 630;

// 로컬 경로는 절대 URL로 변환, 외부 URL은 그대로 사용
const optimizedImageUrl = image.startsWith('http')
  ? image
  : new URL(image.startsWith('/') ? image : `/${image}`, Astro.site).toString();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Search Engine Optimization -->
<meta name="google-adsense-account" content="ca-pub-6612953628765015">
<meta name="naver-site-verification" content="81b18989c06713f3222422328ca0a4eaf8f05f6a" />

<!-- Fonts (halfmoon 디자인 시스템 기본 서체) -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link
	rel="stylesheet"
	href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>

<!-- Icon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="사이트 작성자 이름" />
<meta name="keywords" content={t('meta.keywords')} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={optimizedImageUrl} />
<meta property="og:image:width" content={OG_IMAGE_WIDTH.toString()} />
<meta property="og:image:height" content={OG_IMAGE_HEIGHT.toString()} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale(locale)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={optimizedImageUrl} />
<meta name="twitter:creator" content="@트위터핸들" />

<!-- Mobile App Meta Tags -->
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />
<meta name="apple-mobile-web-app-title" content={SITE_TITLE} />

<!-- Security and Performance -->
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="theme-color" content="#ffffff" />
<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />

