---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { type Locale, hreflangFor } from '../i18n/ui';

const baseHeroImage = "/og-image.png";

// Props 타입을 확장하여 홈페이지와 블로그 포스트를 모두 수용할 수 있도록 함
type Props = {
	title: string;
	description: string;
	heroImage?: string;
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
	githubUrl?: string;
	liveUrl?: string;
	locale?: Locale;
	langAlternate?: string | null;
	alternates?: { hreflang: string; href: string }[];
};

const { title, description, heroImage, locale = 'ko', langAlternate, alternates = [] } = Astro.props;

// A page with a known locale sibling gets ko/en/x-default hreflang for free.
const hreflangAlternates =
	typeof langAlternate === 'string'
		? hreflangFor(locale, Astro.url.pathname, langAlternate, Astro.site)
		: alternates;

// 웹사이트 구조화된 데이터 생성
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"url": Astro.site?.toString(),
	"potentialAction": {
		"@type": "SearchAction",
		"target": {
			"@type": "EntryPoint",
			"urlTemplate": `${Astro.site}search?q={search_term_string}`
		},
		"query-input": "required name=search_term_string"
	}
};
---

<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} image={heroImage ?? baseHeroImage} locale={locale} alternates={hreflangAlternates} />
		<style>
			body {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
			}
			main {
				flex: 1;
				width: calc(100% - 2em);
				max-width: 960px;
				margin: 0 auto;
			}
		</style>
		<!-- Schema.org 구조화된 데이터 -->
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	</head>
	<body>
		<Header locale={locale} langAlternate={langAlternate} />
		<main>
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>

