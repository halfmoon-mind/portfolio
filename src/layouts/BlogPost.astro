---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { type Locale, hreflangFor } from '../i18n/ui';

type Props = CollectionEntry<'blog'>['data'] & {
	translation?: CollectionEntry<'blog'> | null;
	// Header language-toggle target for non-blog callers (e.g. til). null hides it.
	langAlternate?: string | null;
};

const { title, description, pubDate, updatedDate, heroImage, lang = 'ko', translation, langAlternate = null } = Astro.props;
const locale = lang as Locale;

// Blog posts carry their own in-prose toggle + hreflang (below). Other callers
// (til) get the global header toggle and hreflang via langAlternate.
const baseHeadAlternates =
	!translation && typeof langAlternate === 'string'
		? hreflangFor(locale, Astro.url.pathname, langAlternate, Astro.site)
		: [];

const LANG_LABEL = { ko: '한국어', en: 'English' } as const;
// 번역본이 있을 때만 토글 노출. KO를 항상 왼쪽으로 고정.
const langVariants = translation
	? [
			{ code: lang, href: null as string | null },
			{ code: translation.data.lang ?? 'en', href: `/blog/${translation.id}/` },
		].sort((a, b) => (a.code === b.code ? 0 : a.code === 'ko' ? -1 : 1))
	: [];

// 현재 URL 생성
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

// hreflang: 번역본이 있을 때만 ko/en/x-default 상호 링크 (절대 URL, ko가 x-default)
const hreflangLinks = translation
	? (() => {
			const abs = (p: string) => new URL(p, Astro.site).toString();
			const siblingPath = `/blog/${translation.id}/`;
			const koHref = abs(lang === 'ko' ? Astro.url.pathname : siblingPath);
			const enHref = abs(lang === 'en' ? Astro.url.pathname : siblingPath);
			return [
				{ hreflang: 'ko', href: koHref },
				{ hreflang: 'en', href: enHref },
				{ hreflang: 'x-default', href: koHref },
			];
		})()
	: [];

// ISO 형식 날짜 변환 함수
const formatISODate = (date: Date) => {
	return date.toISOString();
};

// 구조화된 데이터 생성
const articleSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": title,
	"description": description,
	"inLanguage": lang === 'en' ? 'en' : 'ko',
	"image": heroImage ? new URL(heroImage, Astro.site).toString() : "",
	"datePublished": formatISODate(pubDate),
	"dateModified": updatedDate ? formatISODate(updatedDate) : formatISODate(pubDate),
	"author": {
		"@type": "Person",
		"name": "심상현"
	},
	"publisher": {
		"@type": "Organization",
		"name": "심상현",
		"logo": {
			"@type": "ImageObject",
			"url": new URL("/favicon.svg", Astro.site).toString()
		}
	},
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": currentUrl
	}
};
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} article={true} locale={locale} alternates={baseHeadAlternates} />
			{hreflangLinks.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				max-height: 500px;
				width: 100%;
				object-fit: cover;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.lang-switch {
				display: flex;
				gap: 0.5em;
				justify-content: flex-end;
				margin-bottom: 0.5em;
				font-size: 0.9em;
			}
			.lang-switch a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.lang-switch a:hover {
				color: rgb(var(--accent));
				text-decoration: underline;
			}
			.lang-switch [aria-current] {
				font-weight: 700;
				color: rgb(var(--black));
			}
		</style>
		<!-- Schema.org 구조화된 데이터 -->
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	</head>

	<body>
		<Header locale={locale} langAlternate={langAlternate} />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt={title} style="max-height: 500px; object-fit: cover;" />}
				</div>
				<div class="prose">
					{langVariants.length > 0 && (
						<nav class="lang-switch" aria-label="언어 선택">
							{langVariants.map((v) =>
								v.href ? (
									<a href={v.href} hreflang={v.code} lang={v.code} data-set-lang={v.code}>{LANG_LABEL[v.code]}</a>
								) : (
									<span aria-current="true" lang={v.code}>{LANG_LABEL[v.code]}</span>
								)
							)}
						</nav>
					)}
					{langVariants.length > 0 && (
						<script is:inline>
							document.querySelectorAll('a[data-set-lang]').forEach(function (a) {
								a.addEventListener('click', function () {
									document.cookie = 'blogLang=' + a.dataset.setLang + '; path=/; max-age=31536000; samesite=lax';
								});
							});
						</script>
					)}
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer locale={locale} />
	</body>
</html>
